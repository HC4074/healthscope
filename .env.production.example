# Copy to .env.production on the deployment host and replace every placeholder.
# Production commands fail before connecting when debug is enabled, the database
# is not PostgreSQL, or the URL still contains a documented placeholder/default.
HEALTHSCOPE_ENVIRONMENT=production
HEALTHSCOPE_DEBUG=false
# HEALTHSCOPE_RELEASE_SHA is embedded in the API image at build time. Do not
# override it in deployment configuration.
HEALTHSCOPE_DATABASE_URL=postgresql+psycopg://healthscope:replace-with-a-secret@database.example.com:5432/healthscope?sslmode=require

# Required: use the attestation-verified immutable GHCR digests published for
# one reviewed main-branch commit. Generate both values together with
# scripts/prepare-production-release.sh <full-commit-sha>.
# HEALTHSCOPE_API_IMAGE=ghcr.io/hc4074/healthscope-api@sha256:<verified-digest>
# HEALTHSCOPE_FRONTEND_IMAGE=ghcr.io/hc4074/healthscope-frontend@sha256:<verified-digest>

# Keep the verified source identities unless an intentional source migration is planned.
HEALTHSCOPE_CMS_PROVIDER_DATA_BASE_URL=https://data.cms.gov/provider-data/api/1
HEALTHSCOPE_CMS_HOSPITAL_DATASET_ID=xubh-q36u
HEALTHSCOPE_CMS_REQUEST_TIMEOUT_SECONDS=10
HEALTHSCOPE_CMS_INGESTION_PAGE_SIZE=100
HEALTHSCOPE_CMS_INGESTION_MAX_ATTEMPTS=3
HEALTHSCOPE_CMS_INGESTION_RETRY_DELAY_SECONDS=1
HEALTHSCOPE_CMS_INGESTION_STALE_AFTER_HOURS=26
HEALTHSCOPE_CDC_DATA_BASE_URL=https://data.cdc.gov
HEALTHSCOPE_CDC_PLACES_COUNTY_DATASET_ID=swc5-untb
HEALTHSCOPE_CDC_REQUEST_TIMEOUT_SECONDS=10
HEALTHSCOPE_FDA_API_BASE_URL=https://api.fda.gov
HEALTHSCOPE_FDA_REQUEST_TIMEOUT_SECONDS=10
HEALTHSCOPE_FDA_REQUEST_MAX_ATTEMPTS=3
HEALTHSCOPE_FDA_REQUEST_RETRY_DELAY_SECONDS=0.5

# Optional secret: increases the openFDA quota. Do not commit a real key.
# HEALTHSCOPE_FDA_API_KEY=
